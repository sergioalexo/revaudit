# Copy this file to ".env" and fill in whichever mode you are using.
# Keep .env private - it is the equivalent of a password. Never share or commit it.

# ---------------------------------------------------------------------------
# Mode 1: API key. For the CLI (revaudit.py) and the single-user web UI
# (serve.py). Create a key at https://dev-portal.onshape.com -> API keys.
# Read scopes are enough - RevAudit never writes to Onshape.
# ---------------------------------------------------------------------------
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Mode 2: OAuth. For the multi-user app (oauth_app.py), where everyone signs in
# with their own Onshape account and no key is shared. Register the app at
# https://dev-portal.onshape.com -> OAuth applications.
# The redirect URI must match the registered one exactly.
# ---------------------------------------------------------------------------
ONSHAPE_OAUTH_CLIENT_ID=
ONSHAPE_OAUTH_CLIENT_SECRET=
ONSHAPE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Extra host:port values people may sign in from - a LAN IP, a hostname, etc.
# localhost and 127.0.0.1 on the running port are always allowed and don't need
# to be listed. Each entry here also needs its own matching
# "http://<host>/oauth/callback" redirect URL registered on the Onshape app,
# or Onshape rejects the sign-in with a redirect_uri mismatch.
ONSHAPE_OAUTH_ALLOWED_HOSTS=192.168.1.50:8000
ONSHAPE_OAUTH_SCOPE=OAuth2Read OAuth2ReadPII

# ---------------------------------------------------------------------------
# Shared settings
# ---------------------------------------------------------------------------

# Enterprise accounts must set this, otherwise API calls resolve against
# cad.onshape.com. OAuth tokens are always issued by oauth.onshape.com.
ONSHAPE_BASE_URL=https://yourcompany.onshape.com

# Optional - skips one API call. Auto-detected when blank.
ONSHAPE_COMPANY_ID=

# Prefill the DXF/SAT/PDF/STEP folder fields in the web UI (and the CLI's
# --export-drawings / --export-step defaults, if given with no explicit path).
# Point these at wherever your shop keeps each file type - a mapped drive or a
# UNC path like \\server\share\DXF FILES. Leave blank to turn that check off.
REVAUDIT_DXF_DIR=
REVAUDIT_SAT_DIR=
REVAUDIT_PDF_DIR=
REVAUDIT_STEP_DIR=

# Required by serve.py before it will listen on anything but localhost.
# Not used by oauth_app.py, which authenticates people through Onshape instead.
REVAUDIT_PASSWORD=

# Shared secret between the host and dxf_indexer.py. The host refuses index
# uploads entirely while this is unset, and rejects any upload without it.
# Set the same value on whichever machine runs the indexer.
REVAUDIT_INDEX_TOKEN=

# Only members of this Onshape company may sign in. Leave blank to allow any
# Onshape account (not recommended for a public URL).
REVAUDIT_ALLOWED_COMPANY_ID=
